// Copy this file to Config/Local.xcconfig (git-ignored) and set your Mac's
// address. Debug builds read it; rebuild after changing it.
//
// Prefer the Mac's Bonjour name, which stays the same when you change
// networks. Find it with: scutil --get LocalHostName
// Fallback: the Mac's LAN IP, e.g. http:/$()/192.168.1.20:8000
//
// Write "http:/$()/" instead of "http://": in an xcconfig file, "//" starts a
// comment, and "$()" expands to nothing.

API_BASE_URL = http:/$()/Your-Mac-Name.local:8000
